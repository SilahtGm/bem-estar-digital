<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppBemEstarDigital.Views.HydrationPage"
             Title="Meta de Hidratação"
             BackgroundColor="#F4F6F8">


    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Voltar" Clicked="Voltar_Clicked"/>
    </ContentPage.ToolbarItems>

    <ScrollView>

        <VerticalStackLayout Padding="22"
                             Spacing="20">

            <!-- Header -->
            <VerticalStackLayout Spacing="4">

                <Label Text="💧 Meta de Hidratação"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#1565C0"/>

                <Label Text="Descubra quanta água você deve beber por dia."
                       FontSize="14"
                       TextColor="#666"/>

            </VerticalStackLayout>

            <!-- Card Principal -->
            <Border StrokeThickness="0"
                    BackgroundColor="#E3F2FD"
                    StrokeShape="RoundRectangle 30"
                    Padding="22">

                <Border.Shadow>
                    <Shadow Brush="#20000000"
                            Offset="0,8"
                            Radius="18"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="18">

                    <Label Text="⚖️ Informe seu peso"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#01579B"/>

                    <Entry x:Name="txtPeso"
                           Placeholder="Ex: 70"
                           Keyboard="Numeric"
                           BackgroundColor="White"
                           HeightRequest="50"
                           TextColor="Black"/>

                    <Button Text="Calcular Meta"
                            BackgroundColor="#0288D1"
                            TextColor="White"
                            CornerRadius="20"
                            HeightRequest="50"
                            FontAttributes="Bold"
                            Clicked="Calcular_Clicked"/>

                </VerticalStackLayout>
            </Border>

            <!-- Resultado -->
            <Border x:Name="resultadoCard"
                    IsVisible="False"
                    StrokeThickness="0"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 30"
                    Padding="22">

                <Border.Shadow>
                    <Shadow Brush="#20000000"
                            Offset="0,6"
                            Radius="14"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">

                    <Label Text="📊 Resultado"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#1565C0"/>

                    <Label x:Name="lblResultado"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="#0288D1"/>

                    <Label x:Name="lblMensagem"
                           FontSize="14"
                           TextColor="#555"
                           LineBreakMode="WordWrap"/>

                </VerticalStackLayout>

            </Border>

            <!-- CARD FRAME - IMPORTANTE -->
            <Frame CornerRadius="18"
Padding="16"
Margin="10,20,10,10"
BackgroundColor="#FFF5F5"
BorderColor="#FFCDD2"
HasShadow="False">

                <VerticalStackLayout Spacing="8">

                    <HorizontalStackLayout Spacing="8"
                        VerticalOptions="Center">

                        <Label Text="⚠️"
            FontSize="22"/>

                        <Label Text="IMPORTANTE"
            FontSize="16"
            FontAttributes="Bold"
            TextColor="#D32F2F"
            TextDecorations="Underline"/>

                    </HorizontalStackLayout>

                    <Label Text="Este aplicativo não substitui a avaliação de um especialista."
        FontSize="14"
        FontAttributes="Bold"
        TextColor="#222"
        LineBreakMode="WordWrap"/>

                    <Label Text="Os resultados exibidos são apenas sugestões informativas e não devem ser utilizados como diagnóstico, orientação médica ou parecer profissional."
        FontSize="13"
        TextColor="#666"
        LineBreakMode="WordWrap"/>

                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>

    </ScrollView>
</ContentPage>