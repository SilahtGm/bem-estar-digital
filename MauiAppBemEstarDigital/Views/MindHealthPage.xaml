<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppBemEstarDigital.Views.MindHealthPage"
             Title="Saúde Mental"
             BackgroundColor="#F4F6F8">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Voltar"
                 Priority="0"
                 Order="Primary"
                 Clicked="Voltar_Clicked"/>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">

            <!-- HEADER -->
            <VerticalStackLayout Spacing="6">

                <Label Text="🧠 Saúde Mental"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#0D47A1"/>

                <Label Text="Cuide da sua mente com músicas relaxantes, registro de humor e meditação guiada."
                       FontSize="15"
                       Opacity="0.7"
                       TextColor="#000"/>

            </VerticalStackLayout>

            <!-- REGISTRO DE HUMOR -->
            <Border StrokeThickness="0"
                    BackgroundColor="#E3F2FD"
                    StrokeShape="RoundRectangle 30"
                    Padding="22">

                <Border.Shadow>
                    <Shadow Brush="#20000000"
                            Offset="0,8"
                            Radius="18"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="12">

                    <Label Text="😊 Como você está se sentindo hoje?"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#1565C0"/>

                    <HorizontalStackLayout Spacing="15"
                       HorizontalOptions="Center">

                        <Button x:Name="btnTriste"
            Text="😢"
            FontSize="22"
            CornerRadius="20"
            BackgroundColor="White"
            WidthRequest="60"
            HeightRequest="60"
            Clicked="SelecionarHumor_Clicked"
            
                                />

                        <Button x:Name="btnNormal"
            Text="😐"
            FontSize="22"
            CornerRadius="20"
            BackgroundColor="White"
            WidthRequest="60"
            HeightRequest="60"
            Clicked="SelecionarHumor_Clicked"
           />

                        <Button x:Name="btnFeliz"
            Text="😊"
            FontSize="22"
            CornerRadius="20"
            BackgroundColor="White"
            WidthRequest="60"
            HeightRequest="60"
            Clicked="SelecionarHumor_Clicked"
            />

                        <Button x:Name="btnMuitoFeliz"
            Text="😁"
            FontSize="22"
            CornerRadius="20"
            BackgroundColor="White"
            WidthRequest="60"
            HeightRequest="60"
            Clicked="SelecionarHumor_Clicked"
            />
                        
                        
                        
                        
                        
                        
                        
                        
                        
                        
                        
                        
                        
                        

                    </HorizontalStackLayout>

                    <Label x:Name="lblStatusHumor"
       FontSize="13"
       TextColor="#666"
       HorizontalOptions="Center"/>

                </VerticalStackLayout>
            </Border>

            <!-- DESCRIÇÃO DO HUMOR -->
            <VerticalStackLayout Spacing="8"
                     Margin="0,10,0,0">

                <Label Text="📝 Quer descrever como está se sentindo?"
           FontSize="14"
           FontAttributes="Bold"
           TextColor="#1565C0"/>

                <Border Stroke="#D0D7E2"
            StrokeThickness="1.2"
            BackgroundColor="White"
            StrokeShape="RoundRectangle 18"
            Padding="12">

                    <Editor x:Name="txtDescricaoHumor"
                Placeholder="Escreva em até 50 caracteres..."
                MaxLength="50"
                AutoSize="TextChanges"
                HeightRequest="90"
                FontSize="14"
                TextColor="#333"
                BackgroundColor="Transparent"/>
                </Border>

                <Label Text="Máximo de 50 caracteres"
           FontSize="11"
           TextColor="#888"
           HorizontalOptions="End"/>

            </VerticalStackLayout>

            <!-- BOTÃO MODERNO -->
            <Button Text="Enviar humor de hoje 💙"
        Clicked="Humor_Clicked"
        HeightRequest="55"
        CornerRadius="28"
        FontSize="15"
        FontAttributes="Bold"
        TextColor="White"
        BackgroundColor="#1976D2"
        Margin="0,8,0,0">

                <Button.Shadow>
                    <Shadow Brush="#30000000"
                Offset="0,6"
                Radius="14"/>
                </Button.Shadow>

            </Button>

            <!-- CARD FRAME - IMPORTANTE -->
            <Frame CornerRadius="18"
Padding="16"
Margin="10,20,10,10"
BackgroundColor="#FFF5F5"
BorderColor="#FFCDD2"
HasShadow="False">

                <VerticalStackLayout Spacing="8">

                    <HorizontalStackLayout Spacing="8"
                        VerticalOptions="Center">

                        <Label Text="⚠️"
            FontSize="22"/>

                        <Label Text="IMPORTANTE"
            FontSize="16"
            FontAttributes="Bold"
            TextColor="#D32F2F"
            TextDecorations="Underline"/>

                    </HorizontalStackLayout>

                    <Label Text="Este aplicativo não substitui a avaliação de um especialista."
        FontSize="14"
        FontAttributes="Bold"
        TextColor="#222"
        LineBreakMode="WordWrap"/>

                    <Label Text="Os resultados exibidos são apenas sugestões informativas e não devem ser utilizados como diagnóstico, orientação médica ou parecer profissional."
        FontSize="13"
        TextColor="#666"
        LineBreakMode="WordWrap"/>

                </VerticalStackLayout>

            </Frame>

            <!-- MÚSICAS RELAXANTES -->
            <Border StrokeThickness="0"
                    BackgroundColor="#E8EAF6"
                    StrokeShape="RoundRectangle 30"
                    Padding="22">

                <Border.Shadow>
                    <Shadow Brush="#20000000"
                            Offset="0,8"
                            Radius="18"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="12">

                    <Label Text="🎵 Músicas Relaxantes"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#3949AB"/>

                    <Label Text="Ouça sons da natureza, piano suave e playlists calmantes."
                           FontSize="14"
                           TextColor="#4A4A4A"/>

                    <Button Text="Abrir Player"
                            BackgroundColor="#3F51B5"
                            TextColor="White"
                            CornerRadius="20"
                            HeightRequest="50"
                            FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Border>

            <!-- MEDITAÇÃO GUIADA -->
            <Border StrokeThickness="0"
                    BackgroundColor="#F3E5F5"
                    StrokeShape="RoundRectangle 30"
                    Padding="22">

                <Border.Shadow>
                    <Shadow Brush="#20000000"
                            Offset="0,8"
                            Radius="18"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="12">

                    <Label Text="🧘 Meditação Guiada"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#8E24AA"/>

                    <Label Text="Sessões rápidas para reduzir ansiedade e melhorar foco."
                           FontSize="14"
                           TextColor="#4A4A4A"/>

                    <Button Text="Iniciar Meditação"
                            BackgroundColor="#8E24AA"
                            TextColor="White"
                            CornerRadius="20"
                            HeightRequest="50"
                            FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Border>

            <!-- HISTÓRICO -->
            <Label Text="Seu histórico emocional"
       FontSize="20"
       FontAttributes="Bold"
       TextColor="#1E1E1E"/>

            <CollectionView x:Name="collectionHistorico"
                HeightRequest="220">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal"
                           ItemSpacing="12"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Frame CornerRadius="20"
                   Padding="15"
                   HasShadow="True"
                   BackgroundColor="White"
                   WidthRequest="180"
                   BorderColor="#E0E0E0">

                            <VerticalStackLayout Spacing="8"
                                     HorizontalOptions="Center">

                                <!-- Emoji -->
                                <Label Text="{Binding Emoji}"
                           FontSize="30"
                           HorizontalTextAlignment="Center"/>

                                <!-- Descrição -->
                                <Label Text="{Binding Descricao}"
                           FontSize="12"
                           TextColor="#555"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"/>

                                <!-- Data -->
                                <Label Text="{Binding Data_humor,
                                  StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                           FontSize="11"
                           TextColor="#999"
                           HorizontalTextAlignment="Center"/>

                            </VerticalStackLayout>

                        </Frame>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>