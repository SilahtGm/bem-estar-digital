<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppBemEstarDigital.Views.DietPage"
             Title="Dietas"
             BackgroundColor="#F4F6F8">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Voltar"
             Priority="0"
             Order="Primary"
             Clicked="Voltar_Clicked"/>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">

            <!-- HEADER -->
            <VerticalStackLayout Spacing="6">

                <Label Text="🥗 Plano Alimentar"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#E65100"/>

                <Label Text="Escolha a dieta ideal para seu objetivo e estilo de vida."
                       FontSize="15"
                       Opacity="0.7"
                       TextColor="#000"/>

            </VerticalStackLayout>

       
            <Border StrokeThickness="0"
                    BackgroundColor="#FFF3E0"
                    StrokeShape="RoundRectangle 30"
                    Padding="22">

                <Border.Shadow>
                    <Shadow Brush="#20000000"
                            Offset="0,8"
                            Radius="18"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="24">

                    <Label Text="🍽️ Selecione sua dieta"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#BF360C"/>

                    <Border Stroke="#D1D5DB"
                           
StrokeThickness="1.2"
BackgroundColor="White"
StrokeShape="RoundRectangle 18"
HeightRequest="42"
HorizontalOptions="Fill"
Padding="0"
Margin="0,10">

                        <Picker x:Name="pickerDietas"
                           
                            SelectedIndexChanged="pickerDietas_SelectedIndexChanged"
                            TextColor="#333"
FontSize="13"
HeightRequest="40"
BackgroundColor="Transparent"
HorizontalOptions="Fill"
VerticalOptions="Center">

                            <Picker.Items>
                                <x:String>Dieta para emagrecimento</x:String>
                                <x:String>Dieta para ganho de massa</x:String>
                                <x:String>Dieta low carb</x:String>
                                <x:String>Dieta vegetariana</x:String>
                                <x:String>Dieta para foco mental</x:String>
                            </Picker.Items>

                        </Picker>

                    </Border>

                    <Border StrokeThickness="0"
        BackgroundColor="White"
        StrokeShape="RoundRectangle 30"
        Padding="20"
        Margin="20">

                        <Border.Shadow>
                            <Shadow Brush="#20000000"
                Offset="0,6"
                Radius="16"/>
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="10">

                            <Label Text="📋 Informações da dieta"
               FontSize="18"
               FontAttributes="Bold"
               TextColor="#E65100"/>

                            <Label x:Name="lblDescricaoDieta"
               Text="Selecione uma dieta para visualizar as informações."
               FontSize="14"
               TextColor="#555"/>

                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Border>

            

            


            <!-- Cards dinâmicos -->
            <CollectionView x:Name="collectionDietas"
                        SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="14"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Frame CornerRadius="20"
                           Padding="18"
                           BackgroundColor="White"
                           BorderColor="#ECECEC"
                           HasShadow="False">

                            <VerticalStackLayout Spacing="10">

                                <Label Text="{Binding Nome}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#222"/>

                                <Label Text="{Binding Refeicao}"
                                   FontSize="14"
                                   TextColor="#444"/>

                                <Label Text="{Binding Alimentos}"
                                   FontSize="14"
                                   TextColor="#444"/>

                                <Frame BackgroundColor="#FFF5F5"
                                   BorderColor="#FFD6D6"
                                   CornerRadius="12"
                                   Padding="10"
                                   HasShadow="False">

                                    <Label Text="{Binding Cuidados}"
                                       FontSize="13"
                                       FontAttributes="Italic"
                                       TextColor="#C62828"/>
                                </Frame>

                            </VerticalStackLayout>

                        </Frame>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>


            <!-- CARD FRAME - IMPORTANTE -->
            <Frame CornerRadius="18"
Padding="16"
Margin="10,20,10,10"
BackgroundColor="#FFF5F5"
BorderColor="#FFCDD2"
HasShadow="False">

                <VerticalStackLayout Spacing="8">

                    <HorizontalStackLayout Spacing="8"
                        VerticalOptions="Center">

                        <Label Text="⚠️"
            FontSize="22"/>

                        <Label Text="IMPORTANTE"
            FontSize="16"
            FontAttributes="Bold"
            TextColor="#D32F2F"
            TextDecorations="Underline"/>

                    </HorizontalStackLayout>

                    <Label Text="Este aplicativo não substitui a avaliação de um especialista."
        FontSize="14"
        FontAttributes="Bold"
        TextColor="#222"
        LineBreakMode="WordWrap"/>

                    <Label Text="Os resultados exibidos são apenas sugestões informativas e não devem ser utilizados como diagnóstico, orientação médica ou parecer profissional."
        FontSize="13"
        TextColor="#666"
        LineBreakMode="WordWrap"/>

                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>