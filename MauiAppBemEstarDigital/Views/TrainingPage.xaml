<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppBemEstarDigital.Views.TrainingPage"
             Title="Treinos"
             BackgroundColor="#F4F6F8">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Voltar"
         Priority="0"
         Order="Primary"
         Clicked="Voltar_Clicked"/>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">

           
            <Label Text="💪 Treinos e Exercícios"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#1E1E1E"/>

            <Label Text="Escolha o treino ideal para o seu momento e cuide do seu corpo."
                   FontSize="15"
                   Opacity="0.7"
                   TextColor="#000"/>

            <!-- CARD PRINCIPAL -->
            <Border StrokeThickness="0"
                    BackgroundColor="#FFF3E0"
                    StrokeShape="RoundRectangle 30"
                    Padding="22">

                <Border.Shadow>
                    <Shadow Brush="#20000000"
                            Offset="0,6"
                            Radius="16"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="24">

                    <Label Text="Escolha seu tipo de treino"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#E65100"/>

                    <!-- PICKER -->
                    <Border Stroke="#D1D5DB"
        StrokeThickness="1.2"
        BackgroundColor="White"
        StrokeShape="RoundRectangle 18"
        HeightRequest="42"
        HorizontalOptions="Fill"
        Padding="0"
        Margin="0,10">

                        <Picker x:Name="pickerTreinos"
            
            SelectedIndexChanged="pickerTreinos_SelectedIndexChanged"
            TextColor="#333"
            FontSize="13"
            HeightRequest="40"
            BackgroundColor="Transparent"
            HorizontalOptions="Fill"
            VerticalOptions="Center">
                            <Picker.Items>
                                <x:String>Emagrecimento</x:String>
                                <x:String>Ganho de Massa</x:String>
                                <x:String>Treino em Casa</x:String>
                                <x:String>Cardio</x:String>
                                <x:String>Alongamento</x:String>
                                <x:String>Funcional</x:String>
                            </Picker.Items>
                        </Picker>

                    </Border>

                    <!-- Cards -->
                    <CollectionView x:Name="collectionTreinos">

                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical"
                           ItemSpacing="10"/>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Frame CornerRadius="18"
                                Padding="15"
                                 Margin="0,0,0,14"
                                 BackgroundColor="#F8F9FA"
                                 BorderColor="#E0E0E0"
                                 HasShadow="False">

                                    <VerticalStackLayout Spacing="8">

                                        <Label Text="{Binding Nome}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#222"/>

                                        <Label Text="{Binding Series}"
                               FontSize="14"
                               TextColor="#444"/>

                                        <Label Text="{Binding Repeticoes}"
                               FontSize="14"
                               TextColor="#444"/>

                                        <Label Text="{Binding Cuidados}"
                               FontSize="13"
                               TextColor="#D32F2F"
                               FontAttributes="Italic"/>

                                    </VerticalStackLayout>

                                </Frame>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    



                    <Button Text="Iniciar treino"
                            BackgroundColor="#FB8C00"
                            TextColor="White"
                            CornerRadius="20"
                            HeightRequest="50"
                            FontAttributes="Bold"
                           />

                </VerticalStackLayout>
            </Border>


            <!-- CARD FRAME - IMPORTANTE -->
            <Frame CornerRadius="18"
       Padding="16"
       Margin="10,20,10,10"
       BackgroundColor="#FFF5F5"
       BorderColor="#FFCDD2"
       HasShadow="False">

                <VerticalStackLayout Spacing="8">

                    <HorizontalStackLayout Spacing="8"
                               VerticalOptions="Center">

                        <Label Text="⚠️"
                   FontSize="22"/>

                        <Label Text="IMPORTANTE"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#D32F2F"
                   TextDecorations="Underline"/>

                    </HorizontalStackLayout>

                    <Label Text="Este aplicativo não substitui a avaliação de um especialista."
               FontSize="14"
               FontAttributes="Bold"
               TextColor="#222"
               LineBreakMode="WordWrap"/>

                    <Label Text="Os resultados exibidos são apenas sugestões informativas e não devem ser utilizados como diagnóstico, orientação médica ou parecer profissional."
               FontSize="13"
               TextColor="#666"
               LineBreakMode="WordWrap"/>

                </VerticalStackLayout>

            </Frame>

            <!-- IMAGEM -->
            <Border StrokeShape="RoundRectangle 25"
                    Padding="0"
                    HeightRequest="180">

                <Border.Shadow>
                    <Shadow Brush="#22000000"
                            Offset="0,6"
                            Radius="16"/>
                </Border.Shadow>

                <Image Source="academia2.jpg"
                       Aspect="AspectFill"/>
            </Border>

            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>