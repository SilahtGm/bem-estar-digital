<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppBemEstarDigital.Views.TrainingPage"
             Title="Treinos"
             BackgroundColor="#F4F6F8">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Voltar"
         Priority="0"
         Order="Primary"
         Clicked="Voltar_Clicked"/>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">

           
            <Label Text="💪 Treinos e Exercícios"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#1E1E1E"/>

            <Label Text="Escolha o treino ideal para o seu momento e cuide do seu corpo."
                   FontSize="15"
                   Opacity="0.7"
                   TextColor="#000"/>

            <!-- CARD PRINCIPAL -->
            <Border StrokeThickness="0"
                    BackgroundColor="#FFF3E0"
                    StrokeShape="RoundRectangle 30"
                    Padding="22">

                <Border.Shadow>
                    <Shadow Brush="#20000000"
                            Offset="0,6"
                            Radius="16"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="24">

                    <Label Text="Escolha seu tipo de treino"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#E65100"/>

                    <!-- PICKER -->
                    <Border Stroke="#D1D5DB"
        StrokeThickness="1.2"
        BackgroundColor="White"
        StrokeShape="RoundRectangle 18"
        HeightRequest="42"
        HorizontalOptions="Fill"
        Padding="0"
        Margin="0,10">

                        <Picker x:Name="pickerTreinos"
            
            SelectedIndexChanged="pickerTreinos_SelectedIndexChanged"
            TextColor="#333"
            FontSize="13"
            HeightRequest="40"
            BackgroundColor="Transparent"
            HorizontalOptions="Fill"
            VerticalOptions="Center">
                            <Picker.Items>
                                <x:String>Emagrecimento</x:String>
                                <x:String>Ganho de Massa</x:String>
                                <x:String>Treino em Casa</x:String>
                                <x:String>Cardio</x:String>
                                <x:String>Alongamento</x:String>
                                <x:String>Funcional</x:String>
                            </Picker.Items>
                        </Picker>

                    </Border>







                    <VerticalStackLayout Padding="20" Spacing="16">

                        <!-- Card -->
                        <Border Stroke="#9FE1CB" StrokeThickness="1" BackgroundColor="White">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="0">

                                <!-- Cabeçalho -->
                                <VerticalStackLayout BackgroundColor="White" Padding="20" Spacing="8">
                                    <Label Text="🩺  Antes de treinar, consulte um médico"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#085041"/>
                                    <Label Text="Uma avaliação médica completa garante sua segurança e melhora seus resultados."
                               FontSize="13"
                               TextColor="#0F6E56"
                               LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>

                                <BoxView HeightRequest="0.5" Color="#9FE1CB"/>

                                <!-- Exames -->
                                <VerticalStackLayout Padding="20,12" Spacing="12">

                                    <Label Text="Exames recomendados"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#888780"/>

                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="♥" TextColor="#0F6E56" FontSize="16"/>
                                        <VerticalStackLayout Spacing="1">
                                            <Label Text="Eletrocardiograma (ECG)" FontSize="14" FontAttributes="Bold" TextColor="#2C2C2A"/>
                                            <Label Text="Avalia o ritmo e a função elétrica do coração." FontSize="12" TextColor="#5F5E5A" LineBreakMode="WordWrap"/>
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>

                                    <BoxView HeightRequest="0.5" Color="#D3D1C7"/>

                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="🩸" FontSize="16"/>
                                        <VerticalStackLayout Spacing="1">
                                            <Label Text="Hemograma completo" FontSize="14" FontAttributes="Bold" TextColor="#2C2C2A"/>
                                            <Label Text="Identifica anemia e condições que afetam o desempenho." FontSize="12" TextColor="#5F5E5A" LineBreakMode="WordWrap"/>
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>

                                    <BoxView HeightRequest="0.5" Color="#D3D1C7"/>

                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="💧" FontSize="16"/>
                                        <VerticalStackLayout Spacing="1">
                                            <Label Text="Glicemia e perfil lipídico" FontSize="14" FontAttributes="Bold" TextColor="#2C2C2A"/>
                                            <Label Text="Verifica açúcar e colesterol para exercícios seguros." FontSize="12" TextColor="#5F5E5A" LineBreakMode="WordWrap"/>
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>

                                    <BoxView HeightRequest="0.5" Color="#D3D1C7"/>

                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="🦴" FontSize="16"/>
                                        <VerticalStackLayout Spacing="1">
                                            <Label Text="Avaliação ortopédica" FontSize="14" FontAttributes="Bold" TextColor="#2C2C2A"/>
                                            <Label Text="Detecta lesões articulares ou musculares." FontSize="12" TextColor="#5F5E5A" LineBreakMode="WordWrap"/>
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>

                                    <BoxView HeightRequest="0.5" Color="#D3D1C7"/>

                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="⚖️" FontSize="16"/>
                                        <VerticalStackLayout Spacing="1">
                                            <Label Text="Avaliação física e IMC" FontSize="14" FontAttributes="Bold" TextColor="#2C2C2A"/>
                                            <Label Text="Define a intensidade e o tipo de treino ideal." FontSize="12" TextColor="#5F5E5A" LineBreakMode="WordWrap"/>
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>

                                </VerticalStackLayout>

                                <BoxView HeightRequest="0.5" Color="#D3D1C7"/>

                                <!-- Rodapé -->
                                <HorizontalStackLayout Spacing="8" Padding="20,12" BackgroundColor="#F1EFE8">
                                    <Label Text="ℹ️" FontSize="14"/>
                                    <Label Text="As sugestões deste app não substituem orientação médica profissional."
                               FontSize="12"
                               TextColor="#5F5E5A"
                               LineBreakMode="WordWrap"
                               HorizontalOptions="FillAndExpand"/>
                                </HorizontalStackLayout>

                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>









                    <!-- Cards -->
                    <CollectionView x:Name="collectionTreinos">

                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical"
                           ItemSpacing="10"/>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Frame CornerRadius="18"
                                Padding="15"
                                 Margin="0,0,0,14"
                                 BackgroundColor="#F8F9FA"
                                 BorderColor="#E0E0E0"
                                 HasShadow="False">

                                    <VerticalStackLayout Spacing="8">

                                        <Label Text="{Binding Nome}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#222"/>

                                        <Label Text="{Binding Series}"
                               FontSize="14"
                               TextColor="#444"/>

                                        <Label Text="{Binding Repeticoes}"
                               FontSize="14"
                               TextColor="#444"/>

                                        <Label Text="{Binding Cuidados}"
                               FontSize="13"
                               TextColor="#D32F2F"
                               FontAttributes="Italic"/>

                                    </VerticalStackLayout>

                                </Frame>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>



                    <Border
                        StrokeThickness="0"
        BackgroundColor="White"
        StrokeShape="RoundRectangle 30"
        Padding="20"
        Margin="20">
                        
                        <Border.Shadow>
                        <Shadow Brush="#20000000"
                    Offset="0,6"
                    Radius="16"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">

                        <Label Text="📋 Informações de treinos"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#E65100"/>

                        <Label x:Name="lblDescricaoDieta"
                        Text="Selecione uma dieta para visualizar as informações."
                        FontSize="14"
                        TextColor="#555"/>

                    </VerticalStackLayout>
            </Border>


        </VerticalStackLayout>
            </Border>


            <!-- CARD FRAME - IMPORTANTE -->
            <Frame CornerRadius="18"
       Padding="16"
       Margin="10,20,10,10"
       BackgroundColor="#FFF5F5"
       BorderColor="#FFCDD2"
       HasShadow="False">

                <VerticalStackLayout Spacing="8">

                    <HorizontalStackLayout Spacing="8"
                               VerticalOptions="Center">

                        <Label Text="⚠️"
                   FontSize="22"/>

                        <Label Text="IMPORTANTE"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#D32F2F"
                   TextDecorations="Underline"/>

                    </HorizontalStackLayout>

                    <Label Text="Este aplicativo não substitui a avaliação de um especialista."
               FontSize="14"
               FontAttributes="Bold"
               TextColor="#222"
               LineBreakMode="WordWrap"/>

                    <Label Text="Os resultados exibidos são apenas sugestões informativas e não devem ser utilizados como diagnóstico, orientação médica ou parecer profissional."
               FontSize="13"
               TextColor="#666"
               LineBreakMode="WordWrap"/>

                </VerticalStackLayout>

            </Frame>

            <!-- IMAGEM -->
            <Border StrokeShape="RoundRectangle 25"
                    Padding="0"
                    HeightRequest="180">

                <Border.Shadow>
                    <Shadow Brush="#22000000"
                            Offset="0,6"
                            Radius="16"/>
                </Border.Shadow>

                <Image Source="academia2.jpg"
                       Aspect="AspectFill"/>
            </Border>

            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>