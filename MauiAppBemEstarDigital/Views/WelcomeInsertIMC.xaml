<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppBemEstarDigital.Views.WelcomeInsertIMC"
             BackgroundColor="#F4F6F8"
             Title="Acompanhe seu IMC">

    <ScrollView>
        <VerticalStackLayout Padding="30"
                             Spacing="25"
                             VerticalOptions="Center">

            <Label Text="⚖️"
                   FontSize="60"
                   HorizontalOptions="Center"/>

            <Label Text="Acompanhe seu IMC"
                   FontSize="30"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#1E1E1E"/>

            <Label Text="Equilíbrio e saúde andam juntos 📏"
                   FontSize="18"
                   HorizontalTextAlignment="Center"
                   TextColor="#00796B"
                   FontAttributes="Bold"/>

            <Label Text="O Índice de Massa Corporal (IMC) é uma métrica simples e essencial para avaliar se o seu peso está adequado à sua altura. Monitorar esse indicador ajuda a prevenir doenças e a planejar melhor sua rotina."
                   FontSize="15"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap"
                   TextColor="#555"/>

            <Border StrokeThickness="0"
                    BackgroundColor="#E0F2F1"
                    StrokeShape="RoundRectangle 25"
                    Padding="20">

                <Border.Shadow>
                    <Shadow Brush="#22000000"
                            Offset="0,6"
                            Radius="12"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">

                    <Label Text="🎯 Descubra sua faixa de peso ideal"
                           FontSize="14"
                           TextColor="#004D40"/>

                    <Label Text="📉 Acompanhe sua evolução corporal de perto"
                           FontSize="14"
                           TextColor="#004D40"/>

                    <Label Text="❤️ Previna problemas cardiovasculares e articulares"
                           FontSize="14"
                           TextColor="#004D40"/>

                    <Label Text="🏃‍♂️ Adapte seus treinos com mais precisão"
                           FontSize="14"
                           TextColor="#004D40"/>

                    <Label Text="🥗 Ajuste sua alimentação conforme sua necessidade"
                           FontSize="14"
                           TextColor="#004D40"/>

                </VerticalStackLayout>
            </Border>

            <Label Text="✨ Conhecer o seu corpo é o primeiro passo para a mudança!"
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   TextColor="#444"/>

            <Button Text="Calcular meu IMC 📊"
                    BackgroundColor="#00897B"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="30"
                    HeightRequest="55"
                    HorizontalOptions="Fill" 
                    Clicked="Navigation_ImcPage"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>